# 影幕 YingMu — 本地环境变量示例
#
# 只保留占位符，绝不填写真实值。本文件会入库；真实配置请放在本地 .env（已被 .gitignore 排除）
# 或使用系统安全配置存储。禁止把任何密钥写进代码、提交记录、Git remote URL 或日志。

# TMDB 元数据刮削（留空表示未配置，应用会显示「未配置」并禁用自动匹配）
YINGMU_TMDB_API_KEY=
YINGMU_TMDB_LANGUAGE=zh-CN

# 网络媒体源凭据：优先使用系统凭据管理器，不要把密码写进这里。
# 下面两个变量只作为「凭据由安全存储注入」的开关示意，不是密码字段。
YINGMU_NETWORK_CREDENTIAL_SOURCE=windows-credential-manager
YINGMU_NETWORK_TIMEOUT_SECONDS=15

# 用户数据目录覆盖（默认 %APPDATA%\YingMu / %LOCALAPPDATA%\YingMu，通常无需修改）
# YINGMU_DATA_DIR=
# YINGMU_CACHE_DIR=
# YINGMU_LOG_DIR=

# GitHub / CI：Token 一律由 GitHub Actions secrets 或 Git Credential Manager 提供，
# 本文件不定义任何 Token 字段。
